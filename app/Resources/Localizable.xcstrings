    "Saved this profile's titles and watch history. Import it on another device or into another profile." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hierdie profiel se titels en kykgeskiedenis is gestoor. Voer dit op 'n ander toestel of in 'n ander profiel in."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የዚህን መገለጫ ርዕሶችና የመመልከት ታሪክ አስቀምጧል። በሌላ መሣሪያ ላይ ወይም ወደ ሌላ መገለጫ ያስገቡት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ عناوين هذا الملف الشخصي وسجل المشاهدة. استورِدها على جهاز آخر أو في ملف شخصي آخر."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই প্ৰ'ফাইলৰ শিৰোনাম আৰু চোৱাৰ ইতিহাস সাঁচি থোৱা হ'ল। ইয়াক আন এটা ডিভাইচত বা আন এটা প্ৰ'ফাইলত ইম্প'ৰ্ট কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu profilin başlıqları və izləmə tarixçəsi yadda saxlanıldı. Onu başqa cihaza və ya başqa profilə idxal edin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захаваны тайтлы і гісторыя прагляду гэтага профілю. Імпартуйце іх на іншай прыладзе ці ў іншы профіль."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заглавията и историята на гледане за този профил са запазени. Импортирайте ги на друго устройство или в друг профил."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই প্রোফাইলের টাইটেল ও দেখার ইতিহাস সংরক্ষণ করা হয়েছে। অন্য ডিভাইসে বা অন্য প্রোফাইলে এটি ইম্পোর্ট করুন।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enrollet titloù an aelad-mañ hag e istor sellet. Enporzhiit anezhañ war un ardivink all pe en un aelad all."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sačuvani su naslovi ovog profila i historija gledanja. Uvezite ih na drugi uređaj ili u drugi profil."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'han desat els títols i l'historial de reproducció d'aquest perfil. Importa'l a un altre dispositiu o a un altre perfil."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na-save ang mga titulo ug watch history niini nga profile. I-import kini sa laing device o ngadto sa laing profile."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tituly a historie sledování tohoto profilu byly uloženy. Naimportujte je na jiném zařízení nebo do jiného profilu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadwyd teitlau a hanes gwylio'r proffil hwn. Mewnforiwch ef ar ddyfais arall neu i broffil arall."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemte denne profils titler og se-historik. Importer den på en anden enhed eller til en anden profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel und Wiedergabeverlauf dieses Profils wurden gespeichert. Importiere sie auf einem anderen Gerät oder in ein anderes Profil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύτηκαν οι τίτλοι και το ιστορικό παρακολούθησης αυτού του προφίλ. Εισαγάγετέ τα σε άλλη συσκευή ή σε άλλο προφίλ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han guardado los títulos y el historial de este perfil. Impórtalo en otro dispositivo o en otro perfil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle profiili pealkirjad ja vaatamisajalugu salvestati. Impordi need teise seadmesse või teise profiili."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil honen izenburuak eta ikusketa historia gorde dira. Inportatu beste gailu batean edo beste profil batean."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنوان‌ها و تاریخچه‌ی تماشای این نمایه ذخیره شد. آن را در دستگاهی دیگر یا در نمایه‌ای دیگر درون‌بری کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallensi tämän profiilin nimikkeet ja katseluhistorian. Tuo se toiselle laitteelle tai toiseen profiiliin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na-save ang mga title at history ng panonood ng profile na ito. I-import ito sa ibang device o sa ibang profile."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goymdi titlar og hyggisøgu hesarar vangamyndar. Innflyt tað á eina aðra eind ella í eina aðra vangamynd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres et l'historique de visionnage de ce profil ont été enregistrés. Importez-les sur un autre appareil ou dans un autre profil."
          }
        },
        "fy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De titels en sjochskiednis fan dit profyl binne bewarre. Ymportearje it op in oar apparaat of yn in oar profyl."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sábháladh teidil na próifíle seo agus a stair féachana. Iompórtáil é ar ghléas eile nó isteach i bpróifíl eile."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaidh tiotalan na pròifil seo agus eachdraidh coimhid a shàbhaladh. Ion-phortaich air inneal eile no gu pròifil eile e."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardáronse os títulos e o historial de visualizado deste perfil. Impórtao noutro dispositivo ou noutro perfil."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ પ્રોફાઇલની ટાઇટલ અને જોવાનો ઇતિહાસ સાચવ્યો. તેને બીજા ઉપકરણ પર અથવા બીજી પ્રોફાઇલમાં ઇમ્પોર્ટ કરો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An adana taken wannan bayanin martaba da tarihin kallo. Shigo da shi a wata na'ura ko cikin wani bayanin martaba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכותרים והיסטוריית הצפייה של פרופיל זה נשמרו. ייבא אותם במכשיר אחר או לפרופיל אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्रोफ़ाइल के शीर्षक और देखने का इतिहास सहेज लिया। इसे किसी अन्य डिवाइस पर या किसी अन्य प्रोफ़ाइल में आयात करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljeni su naslovi i povijest gledanja ovog profila. Uvezite ih na drugi uređaj ili u drugi profil."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sove tit ak istorik gade pwofil sa a. Enpòte l sou yon lòt aparèy oswa nan yon lòt pwofil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentve ennek a profilnak a címei és megtekintési előzményei. Importáld egy másik eszközre vagy egy másik profilba."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Պահպանվեցին այս պրոֆիլի վերնագրերն ու դիտման պատմությունը։ Ներմուծեք այն մեկ այլ սարքում կամ մեկ այլ պրոֆիլ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan judul dan riwayat tontonan profil ini. Impor di perangkat lain atau ke profil lain."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echekwara aha na akụkọ nlele nke profaịlụ a. Bubata ya na ngwaọrụ ọzọ ma ọ bụ n'ime profaịlụ ọzọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vistaði titla og áhorfssögu þessa notandasniðs. Fluttu það inn í annað tæki eða annað notandasnið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono stati salvati i titoli e la cronologia di visione di questo profilo. Importali su un altro dispositivo o in un altro profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールのタイトルと視聴履歴を保存しました。別のデバイスや別のプロフィールに読み込めます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
