    "Delete %@? Its settings and sign-in are removed." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrap %@? Sy instellings en aanmelding word verwyder."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ይሰረዝ? ቅንብሮቹና መግቢያው ይወገዳሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد حذف %@؟ ستُحذف إعداداته وتسجيل دخوله."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ মচিবনে? ইয়াৰ ছেটিংছ আৰু ছাইন-ইন আঁতৰোৱা হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ silinsin? Onun ayarları və girişi silinir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдаліць %@? Яго налады і ўваход будуць выдалены."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да се изтрие ли %@? Настройките и влизането му се премахват."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ মুছবেন? এর সেটিংস ও সাইন-ইন সরিয়ে ফেলা হবে।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dilemel %@? E arventennoù hag e gennaskañ a vez dilamet."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrisati %@? Njegove postavke i prijava se uklanjaju."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols eliminar %@? S'eliminaran la seva configuració i l'inici de sessió."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papason ang %@? Ang settings ug sign-in niini tangtangon."
