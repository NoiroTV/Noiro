            "value" : "%@ inställningar återställda. Starta om appen för att tillämpa allt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mipangilio ya %@ imerejeshwa. Zindua upya programu ili kutumia kila kitu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ அமைப்புகள் மீட்டெடுக்கப்பட்டன. அனைத்தையும் செயல்படுத்த செயலியை மீண்டும் தொடங்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ సెట్టింగ్‌లు పునరుద్ధరించబడ్డాయి. అన్నింటినీ వర్తింపజేయడానికి యాప్‌ను మళ్లీ ప్రారంభించండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Танзимоти %@ барқарор шуд. Барои татбиқи ҳама чиз барномаро аз нав оғоз кунед."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กู้คืนการตั้งค่า %@ แล้ว เปิดแอปใหม่เพื่อให้ทุกอย่างมีผล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ayarları geri yüklendi. Her şeyi uygulamak için uygulamayı yeniden başlatın."
          }
        },
        "tt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ көйләүләре торгызылды. Барысын да куллану өчен кушымтаны яңадан кабыз."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ تەڭشەكلىرى ئەسلىگە كەلتۈرۈلدى. ھەممىنى قوللىنىش ئۈچۈن دېتالنى قايتا قوزغىتىڭ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштування %@ відновлено. Перезапустіть застосунок, щоб застосувати всі зміни."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کی ترتیبات بحال ہو گئیں۔ سب کچھ لاگو کرنے کے لیے ایپ دوبارہ کھولیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sozlamalari tiklandi. Hammasini qo'llash uchun ilovani qayta ishga tushiring."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã khôi phục cài đặt %@. Khởi động lại ứng dụng để áp dụng tất cả."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iisetingi ze-%@ zibuyiseliwe. Vula kwakhona i-app ukuze usebenzise yonke into."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ti mú àwọn ètò %@ padà. Tún app náà ṣí láti lo ohun gbogbo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已恢复 %@ 的设置。请重新启动应用以使全部设置生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已還原 %@ 的設定。請重新啟動 App 以套用所有變更。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izilungiselelo ze-%@ zibuyiselwe. Qalisa kabusha i-app ukuze usebenzise konke."
          }
        }
      }
    },
