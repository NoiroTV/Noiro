        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierakstoties, jūsu papildinājumi un bibliotēka tiek ievilkti lietotnē. Jūsu konts paliek šajā ierīcē."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fidirana dia mitarika ny add-ons sy ny tranombokinao ho ao amin'ny app. Mijanona amin'ity fitaovana ity ny kaontinao."
