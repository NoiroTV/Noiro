    "No catalogs yet. Install an add-on that provides catalogs first." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen katalogusse nie. Installeer eers 'n byvoeging wat katalogusse bied."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ምንም ካታሎጎች የሉም። ካታሎጎች የሚያቀርብ ተጨማሪ ይጫኑ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا كتالوجات بعد. ثبّت أولًا إضافة توفّر كتالوجات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এতিয়ালৈকে কোনো কেটাল'গ নাই। প্ৰথমে কেটাল'গ প্ৰদান কৰা এটা এড-অন ইনষ্টল কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hələ heç bir kataloq yoxdur. Əvvəlcə kataloq təmin edən bir əlavə quraşdırın."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакуль няма каталогаў. Спачатку ўсталюйце дадатак, які прадастаўляе каталогі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все още няма каталози. Първо инсталирайте добавка, която предоставя каталози."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনো কোনো ক্যাটালগ নেই। আগে ক্যাটালগ প্রদান করে এমন একটি অ্যাড-অন ইনস্টল করুন।"
          }
        },
        "br" : {
