        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazat %@? Jeho nastavení a přihlášení budou odstraněny."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dileu %@? Caiff ei osodiadau a'i fewngofnodi eu tynnu."
