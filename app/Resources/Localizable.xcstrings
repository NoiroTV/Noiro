        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos profils, vos réglages et vos clés de métadonnées se synchronisent vers ce compte, chiffrés de bout en bout. Ils se synchronisent aussi automatiquement un instant après chaque modification."
          }
        },
        "fy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo profilen, ynstellings en metadata-kaaien syngronisearje mei dit akkount, end-to-end fersifere. Se syngronisearje ek automatysk in eachwink nei elke wiziging."
