          "stringUnit" : {
            "state" : "translated",
            "value" : "Թաքցնում է CAM և կեղծ որակի աղբյուրները։ «Թաքցնել» / «Պահանջել» բառերը զտում են ցանկն ըստ անվան (ստորակետերով բաժանված)։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyembunyikan sumber CAM dan kualitas palsu. Kata Sembunyikan / Wajibkan menyaring daftar berdasarkan nama (dipisah koma)."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na-ezo isi mmalite CAM na nke mma adịgboroja. Zoo / Chọọ okwu na-esofe ndepụta site n'aha (kewapụrụ site na rịkọma)."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felur CAM- og falsgæðaveitur. Fela / Krefjast orð sía listann eftir nafni (aðgreind með kommum)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde le sorgenti CAM e a qualità falsa. Le parole Nascondi / Richiedi filtrano l'elenco per nome (separate da virgole)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM や画質偽装のソースを非表示にします。「非表示」「必須」のワードで名前を基準にリストを絞り込みます（カンマ区切り）。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndhelikaké sumber CAM lan kualitas palsu. Tembung Dhelikaké / Wajibaké nyaring dhaptar miturut jeneng (dipisah koma)."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მალავს CAM და ცრუ ხარისხის წყაროებს. „დამალვა“ / „მოთხოვნა“ სიტყვები ფილტრავს სიას სახელით (მძიმეებით გამოყოფილი)."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM және жалған сападағы дереккөздерді жасырады. «Жасыру / Талап ету» сөздері тізімді атауы бойынша сүзеді (үтірмен бөлінеді)."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "លាក់ប្រភព CAM និងប្រភពគុណភាពក្លែងក្លាយ។ ពាក្យ លាក់ / តម្រូវ ត្រងបញ្ជីតាមឈ្មោះ (បំបែកដោយសញ្ញាក្បៀស)។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM ಮತ್ತು ನಕಲಿ-ಗುಣಮಟ್ಟದ ಮೂಲಗಳನ್ನು ಮರೆಮಾಡುತ್ತದೆ. ಮರೆಮಾಡಿ / ಅಗತ್ಯವಿದೆ ಪದಗಳು ಹೆಸರಿನ ಮೂಲಕ ಪಟ್ಟಿಯನ್ನು ಫಿಲ್ಟರ್ ಮಾಡುತ್ತವೆ (ಅಲ್ಪವಿರಾಮದಿಂದ ಬೇರ್ಪಡಿಸಲಾಗಿದೆ)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM 및 가짜 화질 소스를 숨깁니다. 숨김 / 필수 단어는 이름으로 목록을 필터링합니다(쉼표로 구분)."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çavkaniyên CAM û kalîteya-derewîn vedişêre. Peyvên Veşêre / Hewce lîsteyê bi navê wan parz dikin (bi bêhnok veqetandî)."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM жана жасалма сапаттагы булактарды жашырат. Жашыруу / Талап кылуу сөздөрү тизмени аты боюнча чыпкалайт (үтүр менен ажыратылат)."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstoppt CAM- a Fake-Qualitéits-Quellen. Wierder verstoppen / verlaangen filtert d'Lëscht no Numm (mat Komma getrennt)."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຊື່ອງແຫຼ່ງ CAM ແລະ ຄຸນນະພາບປອມ. ຄຳທີ່ຈະເຊື່ອງ / ຕ້ອງມີ ຈະກັ່ນຕອງລາຍການຕາມຊື່ (ຄັ່ນດ້ວຍຈຸດ)."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slepia CAM ir netikros kokybės šaltinius. „Slėpti“ / „Reikalauti“ žodžiai filtruoja sąrašą pagal pavadinimą (atskirti kableliais)."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slēpj CAM un viltus kvalitātes avotus. Vārdi laukos “Slēpt” / “Pieprasīt” filtrē sarakstu pēc nosaukuma (atdalot ar komatiem)."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manafina ny loharano CAM sy kalitao sandoka. Ny teny Afeno / Takio dia misivana ny lisitra araka ny anarana (misaraka amin'ny faingo)."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka hunaia ngā pūtake CAM me ngā kounga-tinihanga. Ka tātaria e ngā kupu Huna / Hiahia te rārangi mā te ingoa (kua wehea-e-te-piko)."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сокрива CAM и извори со лажен квалитет. Зборовите за „Сокриј“ / „Барај“ ја филтрираат листата по име (одделени со запирки)."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM, വ്യാജ-ഗുണനിലവാര ഉറവിടങ്ങൾ മറയ്ക്കുന്നു. മറയ്ക്കുക / ആവശ്യമാണ് എന്നീ വാക്കുകൾ പേര് അനുസരിച്ച് പട്ടിക ഫിൽട്ടർ ചെയ്യുന്നു (കോമ ഉപയോഗിച്ച് വേർതിരിച്ചത്)."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM болон хуурамч чанарын эх сурвалжийг нуудаг. Нуух / Шаардах үгс нь жагсаалтыг нэрээр нь шүүдэг (таслалаар тусгаарласан)."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM आणि बनावट-दर्जाचे स्रोत लपवते. लपवा / आवश्यक शब्द नावानुसार यादी फिल्टर करतात (स्वल्पविरामाने वेगळे)."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyembunyikan sumber CAM dan kualiti palsu. Perkataan Sembunyi / Perlukan menapis senarai mengikut nama (dipisahkan dengan koma)."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaħbi sorsi CAM u ta' kwalità falza. Il-kliem Aħbi / Meħtieġ jiffiltraw il-lista skont l-isem (separati bil-virgola)."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM နှင့် အရည်အသွေးအတု အရင်းအမြစ်များကို ဖျောက်ထားသည်။ Hide / Require စကားလုံးများသည် စာရင်းကို အမည်ဖြင့် စစ်ထုတ်သည် (ကော်မာခြား)။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler CAM- og falsk-kvalitet-kilder. Skjul- / Krev-ord filtrerer listen etter navn (kommaseparert)."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM र नक्कली-गुणस्तरका स्रोतहरू लुकाउँछ। लुकाउनुहोस् / आवश्यक शब्दहरूले सूचीलाई नामअनुसार फिल्टर गर्छन् (अल्पविरामले छुट्याइएको)।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt CAM- en nepkwaliteitsbronnen. Verbergen/Vereisen-woorden filteren de lijst op naam (gescheiden door komma's)."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imabisa magwero a CAM ndi a khalidwe lonyenga. Mawu a Hide / Require amasefa mndandanda ndi dzina (olekanitsidwa ndi koma)."
          }
        },
        "oc" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaga las fonts CAM e de falsa qualitat. Los mots a Amagar / Requerir filtran la lista per nom (separats per virgula)."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM ଏବଂ ନକଲି-କ୍ୱାଲିଟି ଉତ୍ସ ଲୁଚାଏ। Hide / Require ଶବ୍ଦ ତାଲିକାକୁ ନାମ ଅନୁସାରେ ଫିଲ୍ଟର କରେ (କମା-ଅଲଗା)।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM ਅਤੇ ਨਕਲੀ-ਕੁਆਲਿਟੀ ਵਾਲੇ ਸਰੋਤ ਲੁਕਾਉਂਦਾ ਹੈ। \"ਲੁਕਾਓ / ਲੋੜੀਂਦੇ\" ਸ਼ਬਦ ਸੂਚੀ ਨੂੰ ਨਾਂ ਮੁਤਾਬਕ ਫ਼ਿਲਟਰ ਕਰਦੇ ਹਨ (ਕੌਮੇ ਨਾਲ ਵੱਖ ਕੀਤੇ)।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywa źródła CAM i o fałszywej jakości. Słowa w polach Ukryj / Wymagaj filtrują listę według nazwy (oddzielone przecinkami)."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM او جعلي-کیفیت سرچینې پټوي. د پټولو / اړینولو کلیمې لیست د نوم له مخې فلټروي (د کامې په واسطه جلا)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta fontes CAM e de qualidade falsa. As palavras de Ocultar / Exigir filtram a lista por nome (separadas por vírgula)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta fontes CAM e de qualidade falsa. As palavras a Ocultar / Exigir filtram a lista por nome (separadas por vírgulas)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascunde sursele CAM și cu calitate falsă. Cuvintele Ascunde / Necesită filtrează lista după nume (separate prin virgulă)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает источники CAM и с поддельным качеством. Слова в полях «Скрывать» / «Требовать» фильтруют список по названию (через запятую)."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bihisha inkomoko za CAM n'iz'ubwiza bw'impimbano. Amagambo yo Guhisha / Gusaba ayungurura urutonde hakurikijwe izina (atandukanijwe n'akitso)."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM ۽ نقلي-معيار وارا ذريعا لڪائي ٿو. لڪايو / لازمي لفظ فهرست کي نالي سان فلٽر ڪن ٿا (ڪاما سان الڳ)."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM සහ ව්‍යාජ-ගුණාත්මක මූලාශ්‍ර සඟවයි. සඟවන්න / අවශ්‍යයි වචන ලැයිස්තුව නම අනුව පෙරයි (කොමා වලින් වෙන් කර)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryje CAM a zdroje s falošnou kvalitou. Slová Skryť / Vyžadovať filtrujú zoznam podľa názvu (oddelené čiarkou)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrije vire CAM in vire z lažno kakovostjo. Besede za Skrij / Zahtevaj filtrirajo seznam po imenu (ločene z vejicami)."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E nana puna CAM ma pepelo-tulaga. E faamama e upu Nana / Manaomia le lisi i le igoa (vaevae i koma)."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inovanza nzvimbo dzeCAM nedzehunhu hwenhema. Mazwi eHide / Require anosefa rondedzero nezita (akaparadzaniswa nekoma)."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuxuu qariyaa ilaha CAM iyo tayo-been ah. Erayada Hide / Require waxay liiska ku shaandheeyaan magaca (hakad ku kala go'ay)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fsheh burimet CAM dhe ato me cilësi të rreme. Fjalët \"Fshih\" / \"Kërko\" e filtrojnë listën sipas emrit (të ndara me presje)."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сакрива CAM и изворе лажног квалитета. Речи за Сакриј / Захтевај филтрирају листу по називу (одвојене зарезима)."
          }
        },
        "st" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E pata mehloli ea CAM le ea boleng ba bohata. Mantsoe a Hide / Require a sefa lethathamo ka lebitso (a arohantsoeng ka comma)."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyumputkeun sumber CAM jeung kualitas palsu. Kecap Sumputkeun / Wajibkeun nyaring daptar dumasar ngaran (dipisah koma)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljer CAM-källor och källor med falsk kvalitet. Orden Dölj/Kräv filtrerar listan efter namn (kommaseparerade)."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huficha vyanzo vya CAM na vyenye ubora bandia. Maneno ya Ficha / Hitaji huchuja orodha kwa jina (yakitenganishwa kwa koma)."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM மற்றும் போலி தர மூலங்களை மறைக்கிறது. மறை / தேவை சொற்கள் பெயரின் அடிப்படையில் பட்டியலை வடிகட்டும் (கமாவால் பிரிக்கப்பட்டவை)."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM మరియు నకిలీ-నాణ్యత మూలాలను దాచుతుంది. దాచు / అవసరం పదాలు పేరు ఆధారంగా జాబితాను ఫిల్టర్ చేస్తాయి (కామాలతో వేరు చేయబడ్డాయి)."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Манбаъҳои CAM ва сифати қалбакиро пинҳон мекунад. Калимаҳои Пинҳон / Талаб рӯйхатро аз рӯи ном филтр мекунанд (бо вергул ҷудошуда)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อนแหล่ง CAM และแหล่งที่ปลอมคุณภาพ คำในช่องซ่อน / ต้องมี ใช้กรองรายการตามชื่อ (คั่นด้วยจุลภาค)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM ve sahte kaliteli kaynakları gizler. Gizle / Gerektir sözcükleri listeyi ada göre süzer (virgülle ayrılmış)."
          }
        },
        "tt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM һәм ялган сыйфатлы чыганакларны яшерә. Сүзләрне яшер / Кирәкле сүзләр исемлекне атамасы буенча фильтрлый (өтер белән аерып)."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CAM ۋە ساختا سۈپەتلىك مەنبەلەرنى يوشۇرىدۇ. «يوشۇرۇش / تەلەپ قىلىش» سۆزلىرى تىزىملىكنى ئىسمى بويىچە سۈزىدۇ (پەش بىلەن ئايرىلغان)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховує джерела з CAM і фейковою якістю. Слова «Приховати» / «Вимагати» фільтрують список за назвою (через кому)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
