        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ফাইলটি নিরাপদে রাখুন। আপনার সেটিংস ফিরিয়ে আনতে Noiro-এ এটি রিস্টোর করুন।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
