        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noiro-ը պետք է փակվի և նորից բացվի՝ ծրագիրը նոր լեզվով ցուցադրելու համար։ Բացեք այն կրկին գլխավոր էկրանից։"
