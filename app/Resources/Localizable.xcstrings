    "If this title should have sources, the add-on may be offline or its config expired. Try another stream add-on." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As hierdie titel bronne moet hê, is die byvoeging dalk vanlyn of sy konfigurasie het verval. Probeer 'n ander stroomtoevoeging."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ርዕስ ምንጮች ሊኖሩት ከሆነ፣ ተጨማሪው ከስራ ውጭ ሊሆን ወይም ውቅሩ ጊዜ ጠፍቶ ሊሆን ይችላል። ሌላ ዥረት ተጨማሪ ሞክሩ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان من المفترض أن يحتوي هذا العنوان على مصادر، فقد تكون الإضافة غير متصلة أو انتهت صلاحية إعداداتها. جرّب إضافة مصادر أخرى."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যদি এই শিৰোনামৰ উৎস থাকিব লাগিছিল, এড-অনটো অফলাইন হ'ব পাৰে বা ইয়াৰ কনফিগ শেষ হৈছে। আন এটা ষ্ট্ৰীম এড-অন চেষ্টা কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu başlığın mənbələri olmalıdırsa, əlavə oflayn ola bilər və ya konfiqurasiyası müddəti bitib. Başqa bir axın əlavəsi sınayın."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі для гэтага тайтла павінны быць крыніцы, дадатак можа быць па-за сеткай ці яго канфігурацыя састарэла. Паспрабуйце іншы дадатак стрымаў."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако това заглавие трябва да има източници, добавката може да е офлайн или конфигурацията ѝ да е изтекла. Опитайте друга добавка за потоци."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই শিরোনামের সোর্স থাকা উচিত হলে, অ্যাড-অনটি অফলাইন থাকতে পারে বা এর কনফিগ মেয়াদোত্তীর্ণ হয়ে থাকতে পারে। অন্য একটি stream অ্যাড-অন চেষ্টা করুন।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma tlefe an titl-mañ kaout mammennoù, marteze emañ an enlugellad ezlinenn pe eo aet e gefluniadur da get. Klaskit un enlugellad lanv all."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako ovaj naslov treba imati izvore, dodatak je možda van mreže ili mu je konfiguracija istekla. Pokušajte s drugim dodatkom za streamove."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aquest títol hauria de tenir fonts, el complement pot estar fora de línia o la seva configuració pot haver caducat. Prova un altre complement de streams."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung kini nga titulo kinahanglan adunay tinubdan, ang add-on tingali offline o na-expire ang config niini. Sulayi ang laing stream add-on."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud by tento titul měl mít zdroje, doplněk může být offline nebo mu vypršela konfigurace. Zkuste jiný doplněk se streamy."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dylai fod gan y teitl hwn ffynonellau, efallai bod yr ychwanegyn all-lein neu bod ei ffurfweddiad wedi dod i ben. Rhowch gynnig ar ychwanegyn ffrydio arall."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis denne titel burde have kilder, kan tilføjelsen være offline, eller dens konfiguration er udløbet. Prøv en anden stream-tilføjelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dieser Titel Quellen haben sollte, ist das Add-on möglicherweise offline oder seine Konfiguration abgelaufen. Probiere ein anderes Stream-Add-on."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν αυτός ο τίτλος θα έπρεπε να έχει πηγές, το πρόσθετο μπορεί να είναι εκτός σύνδεσης ή να έληξε η ρύθμισή του. Δοκιμάστε άλλο πρόσθετο πηγών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si este título debería tener fuentes, el complemento puede estar fuera de línea o su configuración caducada. Prueba otro complemento de fuentes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui sellel pealkirjal peaksid allikad olema, võib lisa olla ühenduseta või selle seadistus aegunud. Proovi mõnda muud voolisa."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titulu honek iturburuak izan behar baditu, gehigarria konektatu gabe egon daiteke edo bere konfigurazioa iraungitu da. Saiatu beste korronteen gehigarri batekin."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر این عنوان باید منبع داشته باشد، ممکن است افزونه آفلاین باشد یا پیکربندی آن منقضی شده باشد. افزونه منبع دیگری را امتحان کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tällä nimikkeellä pitäisi olla lähteitä, lisäosa saattaa olla offline-tilassa tai sen määritys on vanhentunut. Kokeile toista lähdelisäosaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung ang titulong ito ay dapat may mga source, maaaring offline ang add-on o nag-expire na ang config nito. Subukan ang ibang stream add-on."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um hesin titul eigur at hava keldur, kann eykingin vera ótilkoyrd ella uppseting hennara útgingin. Royn eina aðra streym-eyking."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ce titre devrait avoir des sources, l'add-on est peut-être hors ligne ou sa configuration a expiré. Essayez un autre add-on de sources."
          }
        },
        "fy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As dizze titel boarnen hawwe moatte soe, kin de add-on offline wêze of syn konfiguraasje ferrûn. Besykje in oare stream-add-on."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más cóir go mbeadh foinsí ag an teideal seo, seans go bhfuil an breiseán as líne nó gur imigh a chumraíocht as feidhm. Bain triail as breiseán srutha eile."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma bu chòir tùsan a bhith aig an tiotal seo, dh'fhaodadh gu bheil an tuilleadan far loidhne no gu bheil an rèiteachadh air a dhol às. Feuch tuilleadan sruth eile."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se este título debería ter fontes, é posible que o complemento estea fóra de liña ou a súa configuración caducara. Proba outro complemento de fluxo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જો આ શીર્ષક પાસે સ્રોત હોવા જોઈએ, તો add-on ઑફલાઇન હોઈ શકે અથવા તેનું કોન્ફિગ સમાપ્ત થઈ ગયું હોઈ શકે. બીજું stream add-on અજમાવો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idan wannan taken ya kamata ya sami tushe, ƙarin abun na iya kasancewa a kashe ko saitinsa ya ƙare. Gwada wani ƙarin abu na stream."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם לכותר זה אמורים להיות מקורות, ייתכן שההרחבה לא מקוונת או שתצורתה פגה. נסה הרחבת מקורות אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि इस टाइटल के स्रोत होने चाहिए, तो ऐड-ऑन ऑफ़लाइन हो सकता है या उसका कॉन्फ़िग समाप्त हो गया हो सकता है। कोई अन्य stream ऐड-ऑन आज़माएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako bi ovaj naslov trebao imati izvore, dodatak je možda izvan mreže ili mu je konfiguracija istekla. Pokušajte s drugim dodatkom za streamove."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tit sa a ta dwe gen sous, add-on an ka offline oswa konfigirasyon li ekspire. Eseye yon lòt add-on stream."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ehhez a címhez kellene lennie forrásnak, a kiegészítő offline lehet, vagy lejárt a konfigurációja. Próbálj ki egy másik stream-kiegészítőt."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Եթե այս վերնագրի աղբյուրներ պետք է լինեն, հավելանյութն, հնարավոր է, անցանց է կամ կարգաբերումն ժամկետանց է։ Փորձեք մեկ այլ հոսքային հավելանյութ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika judul ini seharusnya memiliki sumber, add-on mungkin sedang offline atau konfigurasinya kedaluwarsa. Coba add-on stream lain."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ bụrụ na aha a kwesịrị inwe isi mmalite, ngwakọ ahụ nwere ike ịnọ offline ma ọ bụ nhazi ya agwụla. Nwaa ngwakọ stream ọzọ."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ef þessi titill á að vera með heimildir getur viðbótin verið ótengt eða stillingarnar þess liðnar út. Prófaðu aðra streymisviðbót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se questo titolo dovrebbe avere sorgenti, il componente aggiuntivo potrebbe essere offline o la sua configurazione scaduta. Prova un altro componente per le sorgenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタイトルにソースがあるはずの場合、アドオンがオフラインか、設定の有効期限が切れている可能性があります。別のストリームアドオンを試してください。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yèn judhul iki mesthiné duwé sumber, add-on bisa waé offline utawa konfigurasiné kadaluwarsa. Coba add-on stream liyané."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თუ ამ სათაურს წყაროები უნდა ჰქონდეს, შეიძლება დამატება ოფლაინ იყოს ან მისი კონფიგურაცია ვადაგასული. სცადეთ სხვა ნაკადის დამატება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Егер бұл тақырыпта дерек көздер болуы керек болса, қондырма желіден тыс немесе конфигурациясының мерзімі өткен болуы мүмкін. Басқа ағын қондырмасын қолданып көріңіз."
