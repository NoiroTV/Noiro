        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Streams\" ကို ဖော်ပြသည့် (Catalogs သို့မဟုတ် Metadata သာမက) တစ်ခုကို Add-on များတွင် စစ်ဆေးပါ။ app ကို မကြာသေးမီက အတင်းပိတ်ခဲ့ပါက သင့် add-on များ ပြန်တင်ရန် ၎င်းကို ပြန်ဖွင့်ပါ၊ သို့မဟုတ် stream add-on တစ်ခုကို ပြန်ထည့်ပါ။"
          }
        },
        "nb" : {
