          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn ngôn ngữ của ứng dụng. \"Mặc định của hệ thống\" theo ngôn ngữ thiết bị của bạn. Noiro phải thoát và mở lại để áp dụng ngôn ngữ mới."
