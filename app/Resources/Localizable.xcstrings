          }
        },
        "st" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E pata mehloli ea CAM le ea boleng ba bohata. Mantsoe a Hide / Require ke di-pattern tsa regex tse sa natseng litlhaku tse kholo/tse nyenyane (pattern e sa sebetseng ea hlokomolohuoa)."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyumputkeun sumber CAM jeung kualitas palsu. Kecap Sumputkeun / Wajibkeun mangrupa pola regex nu teu peka aksara gedé (pola nu teu valid diabaikan)."
