    "Keep this file safe. Restore it in Noiro to bring your settings across." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hou hierdie lêer veilig. Herstel dit in Noiro om jou instellings oor te bring."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህን ፋይል በደህና ይያዙት። ቅንብሮችዎን ለማስተላለፍ በNoiro ውስጥ ያድሱት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بهذا الملف في مكان آمن. استعِده في Noiro لنقل إعداداتك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ফাইলটো সুৰক্ষিত ৰাখক। আপোনাৰ ছেটিংছ আনিবলৈ Noiro-ত ইয়াক পুনৰুদ্ধাৰ কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu faylı təhlükəsiz saxlayın. Ayarlarınızı köçürmək üçün onu Noiro-də bərpa edin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захоўвайце гэты файл у бяспецы. Аднавіце яго ў Noiro, каб перанесці свае налады."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пазете този файл на сигурно място. Възстановете го във Noiro, за да прехвърлите настройките си."
