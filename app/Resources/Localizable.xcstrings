        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Vetëm lidhjet e drejtpërdrejta\" është aktivizuar, prandaj transmetimi me torrent dhe konfigurimi i serverit janë joaktive."
