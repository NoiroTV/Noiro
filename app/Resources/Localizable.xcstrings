        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stílíonn sé fotheidil an tseinnteora ionsuite. Roghnaigh cén rian fotheidil le taispeáint ón seinnteoir agus tú ag féachaint."
