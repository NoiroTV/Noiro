            "value" : "Yalnızca Doğrudan Bağlantılar etkin olduğundan torrent akışı ve sunucu yapılandırması devre dışı."
          }
        },
        "tt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тик туры сылтамалар кабызылган, шуңа торрент агымы һәм сервер көйләмәсе эшләми."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«پەقەت بىۋاسىتە ئۇلانمىلار» قوزغىتىلغان، شۇڭا torrent ئېقىنى ۋە مۇلازىمېتىر سەپلىمىسى ئاكتىپسىز."
