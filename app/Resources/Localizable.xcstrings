        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn profaìlì, ètò, àti bọtìnì metadata rẹ máa ń múra síra sí àkàwé yìí, ní ìsírí láti ìbẹ̀rẹ̀-dé-ìparí. Wọ́n tún máa ń múra síra fúnraawọn ní ìṣẹ́jú díẹ̀ lẹ́yìn ìyípadà èyíkéyìí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的配置文件、设置和元数据密钥会端到端加密同步到此账户。它们也会在任何更改后片刻自动同步。"
