            "value" : "Noiro muss zoumaachen an nei opgoen fir d'App an der neier Sprooch unzeweisen. Maach se erëm op vum Startbildschierm."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
