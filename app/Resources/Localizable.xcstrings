    "Signing in pulls your add-ons and library into the app. Your account stays on this device." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanmelding haal jou byvoegings en biblioteek in die app in. Jou rekening bly op hierdie toestel."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መግባት ተጨማሪዎቹ እና ቤተ-መፅሐፍቱ ወደ መተግበሪያው ያምጣሉ። መለያዎ በዚህ መሳሪያ ላይ ይቆያሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسحب تسجيل الدخول إضافاتك ومكتبتك إلى التطبيق. يبقى حسابك على هذا الجهاز."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ছাইন ইন কৰিলে আপোনাৰ এড-অন আৰু লাইব্ৰেৰী এপ্‌লৈ আহে। আপোনাৰ একাউণ্ট এই ডিভাইচতে থাকে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daxil olmaq əlavələrinizi və kitabxananızı tətbiqə çəkir. Hesabınız bu cihazda qalır."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уваход падцягвае вашы дадаткі і бібліятэку ў дадатак. Ваш акаўнт застаецца на гэтай прыладзе."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влизането изтегля вашите добавки и библиотека в приложението. Вашият акаунт остава на това устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাইন ইন করলে আপনার অ্যাড-অন এবং লাইব্রেরি অ্যাপে চলে আসে। আপনার অ্যাকাউন্ট এই ডিভাইসেই থাকে।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kennaskañ a zeg ho enlugelladoù hag ho levraoueg en arload. Ho kont a chom war an ardivink-mañ."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijava povlači vaše dodatke i biblioteku u aplikaciju. Vaš račun ostaje na ovom uređaju."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar sessió importa els teus complements i biblioteca a l'app. El teu compte es queda en aquest dispositiu."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pag-sign in nagbira sa imong add-ons ug library ngadto sa app. Ang imong account magpabilin niini nga device."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlášení načte vaše doplňky a knihovnu do aplikace. Váš účet zůstává v tomto zařízení."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae mewngofnodi'n tynnu eich ychwanegion a'ch llyfrgell i mewn i'r ap. Mae'ch cyfrif yn aros ar y ddyfais hon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du logger ind, hentes dine tilføjelser og dit bibliotek ind i appen. Din konto bliver på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die Anmeldung werden deine Add-ons und deine Bibliothek in die App geladen. Dein Konto bleibt auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση φέρνει τα πρόσθετα και τη βιβλιοθήκη σας στην εφαρμογή. Ο λογαριασμός σας παραμένει σε αυτή τη συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al iniciar sesión, tus complementos y tu biblioteca se cargan en la app. Tu cuenta permanece en este dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisselogimine toob su lisad ja teegi rakendusse. Su konto jääb sellesse seadmesse."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saioa hasteak zure gehigarriak eta liburutegia aplikaziora eramaten ditu. Zure kontua gailu honetan geratzen da."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ورود به حساب، افزونه‌ها و کتابخانه شما را به برنامه می‌آورد. حساب شما روی این دستگاه می‌ماند."
