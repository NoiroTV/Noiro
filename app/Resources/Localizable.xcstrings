        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดใช้เฉพาะลิงก์โดยตรงอยู่ การสตรีมทอร์เรนต์และการตั้งค่าเซิร์ฟเวอร์จึงไม่ทำงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
