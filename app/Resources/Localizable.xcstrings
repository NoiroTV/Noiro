    "Pick how the scrubber looks during playback. Each preview animates the real design." : {

    },
    "Pick how the scrubber looks during playback. The preview shows each design." : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies hoe die skuifbalk tydens afspeel lyk. Die voorskou wys elke ontwerp."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ፕሌይባክ ወቅት ስካርቡ እንዴት እንደሚታይ ምረጡ። ቅድመ ዕይታ እያንዳንዱን ንድፍ ያሳያል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر كيف يبدو شريط التمرير أثناء التشغيل. تعرض المعاينة كل تصميم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্লেবেকৰ সময়ত স্ক্ৰাবাৰটো কেনে দেখা যাব বাছক। পূৰ্বদৰ্শনে প্ৰতিটো ডিজাইন দেখুৱায়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatma zamanı sürüşdürücünün necə göründüyünü seçin. Ön baxış hər dizaynı göstərir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберыце, як выглядае паласа праматкі падчас прайгравання. Папярэдні прагляд паказвае кожны дызайн."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете как изглежда лентата за превъртане по време на възпроизвеждане. Прегледът показва всеки дизайн."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্লেব্যাকের সময় স্ক্রাবার কেমন দেখাবে তা বেছে নিন। প্রিভিউ প্রতিটি ডিজাইন দেখায়।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibabit penaos e sell ar barrenn-treuzikañ e-pad ar c'hoari. Ar rakwel a ziskouez pep neuz."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite kako izgleda traka za premotavanje tokom reprodukcije. Pregled prikazuje svaki dizajn."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria com es veu la barra de desplaçament durant la reproducció. La previsualització mostra cada disseny."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilia kung unsa ang hitsura sa scrubber panahon sa playback. Ang preview mopakita sa matag disenyo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, jak vypadá posuvník během přehrávání. Náhled ukazuje každý vzhled."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dewiswch sut mae'r bar sgrolio'n edrych wrth chwarae. Mae'r rhagolwg yn dangos pob dyluniad."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg hvordan søjlen ser ud under afspilning. Forhåndsvisningen viser hvert design."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
