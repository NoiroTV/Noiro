        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaħbi sorsi akbar mil-limitu (eż. 1080p iżda mhux fajl ta' 20 GB). Sorsi bla daqs iddikjarat jinżammu."
