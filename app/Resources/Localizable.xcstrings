    "This profile has no saved titles or watch history yet." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hierdie profiel het nog geen gestoorde titels of kykgeskiedenis nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ መገለጫ እስካሁን ምንም የተቀመጡ ርዕሶች ወይም የመመልከት ታሪክ የለውም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي هذا الملف الشخصي على عناوين محفوظة أو سجل مشاهدة بعد."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই প্ৰ'ফাইলৰ এতিয়ালৈকে কোনো সাঁচি থোৱা শিৰোনাম বা চোৱাৰ ইতিহাস নাই।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu profildə hələ yadda saxlanılmış başlıq və ya izləmə tarixçəsi yoxdur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У гэтага профілю пакуль няма захаваных тайтлаў ці гісторыі прагляду."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този профил все още няма запазени заглавия или история на гледане."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই প্রোফাইলে এখনো কোনো সংরক্ষিত টাইটেল বা দেখার ইতিহাস নেই।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'en deus an aelad-mañ titl enrollet nag istor sellet ebet c'hoazh."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj profil još nema sačuvanih naslova ni historije gledanja."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest perfil encara no té títols desats ni historial de reproducció."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kini nga profile wala pa'y na-save nga titulo o watch history."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento profil zatím nemá žádné uložené tituly ani historii sledování."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nid oes gan y proffil hwn unrhyw deitlau wedi'u cadw na hanes gwylio eto."
          }
        },
