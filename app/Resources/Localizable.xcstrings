        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV-യിൽ ഫോണുമായി സ്കാൻ-ചെയ്യുന്ന ബാക്കപ്പ് വരുന്നു: ബാക്കപ്പ് ഒരു QR കോഡ് കാണിക്കും, നിങ്ങൾ അത് ഫോൺ ഉപയോഗിച്ച് സ്കാൻ ചെയ്യുന്നു, നിങ്ങളുടെ ക്രമീകരണങ്ങൾ നിങ്ങളുടെ Noiro അക്കൗണ്ടിലേക്ക് സംരക്ഷിക്കപ്പെടും. പുനഃസ്ഥാപനം അവ ഉടനടി തിരികെ കൊണ്ടുവരാൻ മറ്റൊരു കോഡ് കാണിക്കും. അതുവരെ, സൈൻ ഇൻ ചെയ്യുന്നത് നിങ്ങളുടെ ലൈബ്രറി, ആഡ്-ഓണുകൾ, കാഴ്ച ചരിത്രം എന്നിവ ഇവിടെ പുനഃസ്ഥാപിക്കുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
