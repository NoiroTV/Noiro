        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imabisa magwero akulu kuposa malire (mwachitsanzo 1080p koma osati fayilo la 20 GB). Magwero opanda kukula konenedwa amasungidwa."
