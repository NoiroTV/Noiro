        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ձեր պրոֆիլները, կարգավորումները և մետատվյալների բանալիները համաժամեցվում են այս հաշվի հետ, ծայրից-ծայր ծածկագրված։ Ցանկացած փոփոխությունից մի պահ անց ավտոմատ կհամաժամեցվեն։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil, pengaturan, dan kunci metadata Anda disinkronkan ke akun ini, terenkripsi ujung-ke-ujung. Semuanya juga tersinkron otomatis sesaat setelah ada perubahan."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profaịlụ, ntọala, na igodo metadata gị na-emekọrịta na akaụntụ a, ezoro ezo site na njedebe ruo njedebe. Ha na-emekọrịtakwa na-akpaghị aka obere oge mgbe mgbanwe ọ bụla gasịrị."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prófílar, stillingar og lýsigagnalyklar þínir samstillast við þennan reikning, dulkóðaðir frá enda til enda. Þeir samstillast einnig sjálfkrafa augnablik eftir hverja breytingu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi profili, le impostazioni e le chiavi dei metadati si sincronizzano con questo account, cifrati end-to-end. Si sincronizzano anche automaticamente subito dopo ogni modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイル、設定、メタデータのキーが、エンドツーエンド暗号化でこのアカウントに同期されます。変更後も少し経つと自動的に同期されます。"
